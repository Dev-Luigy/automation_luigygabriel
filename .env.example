# Local file for the assessment. Production should use the approved datastore.
EXPENSE_AGENT_DATABASE_PATH=./data/expense-agent.sqlite3

# Immutable source/lock identity. deploy/aws/deploy.sh derives this from Git and uv.lock.
EXPENSE_AGENT_BUILD_ID=local-unversioned

# WAL is suitable for the local filesystem. The AWS assessment sandbox selects
# DELETE because SQLite WAL is not supported over the EFS packaging bridge.
EXPENSE_AGENT_SQLITE_JOURNAL_MODE=WAL

# Immutable local assessment evidence. The default is a sibling of the SQLite
# file; set it explicitly so operators know what must be backed up together.
EXPENSE_AGENT_ATTACHMENT_ROOT=./data/attachments
# Default 4 MiB. Accepted configuration range: 1024 through 10485760 bytes.
EXPENSE_AGENT_ATTACHMENT_MAX_BYTES=4194304
# EFS Access Points may enforce an owner different from the Lambda process UID.
# Local default: the process effective UID. AWS sandbox: 1000 from the access point.
# EXPENSE_AGENT_ATTACHMENT_OWNER_UID=1000

# Generate hashes with: expense-agent-hash-password
# Never commit a real password or a production reviewer list.
EXPENSE_AGENT_REVIEWERS_JSON='[{"username":"reviewer","reviewer_id":"replace-me","email":"reviewer@example.com","display_name":"Finance Reviewer","password_hash":"replace-with-generated-pbkdf2-hash","roles":["admin"]}]'

# Assessment roles are submitter, reviewer, auditor, and admin. Use separate
# identities in realistic demos; the single admin above keeps the sandbox setup small.

# At least 32 unpredictable characters. Keep the real value in a secret manager.
EXPENSE_AGENT_CSRF_SECRET=

# Offline and reproducible by default. To call a live AI endpoint, change this
# to http_json and configure every required field below. The endpoint must use
# HTTPS; parameters are strict JSON scalar values only.
EXPENSE_AGENT_EXTRACTOR_MODE=deterministic
# EXPENSE_AGENT_EXTRACTOR_ENDPOINT=https://provider.example/v1/extract
# EXPENSE_AGENT_EXTRACTOR_PROVIDER=provider-name
# EXPENSE_AGENT_EXTRACTOR_MODEL=model-name
# EXPENSE_AGENT_EXTRACTOR_API_KEY=replace-with-secret-manager-value
# EXPENSE_AGENT_EXTRACTOR_TIMEOUT_SECONDS=10
# EXPENSE_AGENT_EXTRACTOR_MAX_RESPONSE_BYTES=262144
# EXPENSE_AGENT_EXTRACTOR_PARAMETERS_JSON={"temperature":0}

# Keep true outside local development. TLS is normally terminated by a trusted ingress.
EXPENSE_AGENT_REQUIRE_HTTPS=true

# Comma-separated hostnames accepted by the HTTP server.
EXPENSE_AGENT_ALLOWED_HOSTS=localhost,127.0.0.1

# Only trust the IP/CIDR of the ingress that terminates TLS and sets forwarded headers.
EXPENSE_AGENT_FORWARDED_ALLOW_IPS=127.0.0.1

EXPENSE_AGENT_HOST=127.0.0.1
EXPENSE_AGENT_PORT=8000
