# Local file for the assessment. Production should use the approved datastore.
EXPENSE_AGENT_DATABASE_PATH=./data/expense-agent.sqlite3

# Generate hashes with: expense-agent-hash-password
# Never commit a real password or a production reviewer list.
EXPENSE_AGENT_REVIEWERS_JSON='[{"username":"reviewer","reviewer_id":"replace-me","email":"reviewer@example.com","display_name":"Finance Reviewer","password_hash":"replace-with-generated-pbkdf2-hash"}]'

# At least 32 unpredictable characters. Keep the real value in a secret manager.
EXPENSE_AGENT_CSRF_SECRET=

# Keep true outside local development. TLS is normally terminated by a trusted ingress.
EXPENSE_AGENT_REQUIRE_HTTPS=true

# Comma-separated hostnames accepted by the HTTP server.
EXPENSE_AGENT_ALLOWED_HOSTS=localhost,127.0.0.1

# Only trust the IP/CIDR of the ingress that terminates TLS and sets forwarded headers.
EXPENSE_AGENT_FORWARDED_ALLOW_IPS=127.0.0.1

EXPENSE_AGENT_HOST=127.0.0.1
EXPENSE_AGENT_PORT=8000
